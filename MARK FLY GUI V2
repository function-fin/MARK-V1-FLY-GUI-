local TweenService = game:GetService("TweenService")

local flying = false
local boostLevel = 0 
local currentFlySpeed = 50
local moveVector = Vector3.new(0,0,0)
local activeTouch = nil 

-- Variáveis para controle do teclado (PC)
local keysPressed = {W = false, A = false, S = false, D = false}

local ANIMS = {
    IDLE = {id = 89068086839142, speed = 1, priority = Enum.AnimationPriority.Action4}, 
    WALK = {id = 137168637932487, speed = 1.5, priority = Enum.AnimationPriority.Action4}, 
    RUN  = {id = 138488768673643, speed = 1.2, priority = Enum.AnimationPriority.Action4}   
}

