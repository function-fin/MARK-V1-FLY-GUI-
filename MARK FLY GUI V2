local function styleButton(btn, text, pos)
    btn.Size = UDim2.new(0, 130, 0, 50)
    btn.Position = pos
    btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    
    -- Fonte Arcade Pixel e ajuste de tamanho
    btn.Font = Enum.Font.Arcade
    btn.TextSize = 20 
    
    btn.ZIndex = 10; btn.BorderSizePixel = 0
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0.5, 0)
    
    local stroke = Instance.new("UIStroke", btn)
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; stroke.Thickness = 2.5
    
    -- Borda Branca
    stroke.Color = Color3.fromRGB(255, 255, 255) 
end

local BoostBtn = Instance.new("TextButton", ButtonFrame)
styleButton(BoostBtn, "BOOST", UDim2.new(0, 0, 0, 0))
BoostBtn.Visible = false

local MainBtn = Instance.new("TextButton", ButtonFrame)
styleButton(MainBtn, "FLY", UDim2.new(0, 0, 0, 55))

local function makeDraggable(guiObj, targetFrame)
    local dragging, dragInput, dragStart, startPos
    guiObj.InputBegan:Connect(function(input)
        if targetFrame == ButtonFrame and flying then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = targetFrame.Position
            input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
        end
    end)
    guiObj.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
    end)
    UIS.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            targetFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

makeDraggable(MainBtn, ButtonFrame)
makeDraggable(IconButton, IconButton)

local lastClick = 0
IconButton.MouseButton1Click:Connect(function()
    local now = tick()
    if now - lastClick < 0.35 then
        Assets:Destroy()
        return
    end
    lastClick = now
    ButtonFrame.Visible = not ButtonFrame.Visible
end)

local AnalogBase = Instance.new("Frame", Assets)
AnalogBase.Size = UDim2.new(0, 220, 0, 220)
AnalogBase.Position = UDim2.new(0.05, 0, 0.58, 0)
AnalogBase.BackgroundTransparency = 1; AnalogBase.Visible = false

AnalogBase.InputBegan:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) and not activeTouch then
        activeTouch = input
    end
end)

UIS.InputChanged:Connect(function(input)
    if input == activeTouch then
        local basePos = AnalogBase.AbsolutePosition + (AnalogBase.AbsoluteSize / 2)
        local inputPos = Vector2.new(input.Position.X, input.Position.Y)
        local diff = inputPos - basePos
        if diff.Magnitude > 10 then
            local dir = diff.Unit
            moveVector = Vector3.new(dir.X, 0, dir.Y)
        else
            moveVector = Vector3.new(0,0,0)
        end
    end
end)

UIS.InputEnded:Connect(function(input)
    if input == activeTouch then activeTouch = nil; moveVector = Vector3.new(0, 0, 0) end
end)

-- SISTEMA DE TECLADO PARA PC
UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.W or input.KeyCode == Enum.KeyCode.Up then keysPressed.W = true end
    if input.KeyCode == Enum.KeyCode.S or input.KeyCode == Enum.KeyCode.Down then keysPressed.S = true end
    if input.KeyCode == Enum.KeyCode.A or input.KeyCode == Enum.KeyCode.Left then keysPressed.A = true end
    if input.KeyCode == Enum.KeyCode.D or input.KeyCode == Enum.KeyCode.Right then keysPressed.D = true end
end)

UIS.InputEnded:Connect(function(input, gameProcessed)
    if input.KeyCode == Enum.KeyCode.W or input.KeyCode == Enum.KeyCode.Up then keysPressed.W = false end
    if input.KeyCode == Enum.KeyCode.S or input.KeyCode == Enum.KeyCode.Down then keysPressed.S = false end
    if input.KeyCode == Enum.KeyCode.A or input.KeyCode == Enum.KeyCode.Left then keysPressed.A = false end
    if input.KeyCode == Enum.KeyCode.D or input.KeyCode == Enum.KeyCode.Right then keysPressed.D = false end
end)

local currentTrack = nil
local lastAnimId = nil

local function PlayUniversalAnim(animData)
    local char = plr.Character
    if not char or not char:FindFirstChild("Humanoid") then return end
    local animIdStr = "rbxassetid://"..tostring(animData.id)
    if lastAnimId == animIdStr then return end
    lastAnimId = animIdStr
    if currentTrack then currentTrack:Stop(0.3) end
    local success, asset = pcall(function() return game:GetObjects(animIdStr)[1] end)
    if success and asset and asset:IsA("Animation") then
        currentTrack = char.Humanoid:LoadAnimation(asset)
    else
        local animObj = Instance.new("Animation"); animObj.AnimationId = animIdStr
        currentTrack = char.Humanoid:LoadAnimation(animObj)
    end
    if currentTrack then
        currentTrack.Priority = animData.priority
        currentTrack:Play(0.3); currentTrack:AdjustSpeed(animData.speed)
    end
end

local function StartFly()
    local char = plr.Character
    if not char then return end
    local hrp = char:WaitForChild("HumanoidRootPart")
    local hum = char:WaitForChild("Humanoid")
    local camera = workspace.CurrentCamera
    
    local bg = Instance.new("BodyGyro", hrp); bg.P = 9e4; bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
    local bv = Instance.new("BodyVelocity", hrp); bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
    
    hum.CameraOffset = Vector3.new(0, 2.5, 0)
    
    task.spawn(function()
        while flying do
            RunService.RenderStepped:Wait()
            if not char or not hrp.Parent then break end
            hum.PlatformStand = true
            local camCF = camera.CFrame
            
            if boostLevel == 0 then currentFlySpeed = 50
            elseif boostLevel == 1 then currentFlySpeed = 160
            elseif boostLevel == 2 then currentFlySpeed = 380
            elseif boostLevel == 3 then currentFlySpeed = 780
            end
            
            -- Lógica de Movimento Unificada (PC + Mobile)
            local finalMoveVector = Vector3.new(0,0,0)
            
            if UIS.TouchEnabled and not UIS.KeyboardEnabled then
                -- Controle Mobile (Analógico)
                finalMoveVector = moveVector
            else
                -- Controle PC (WASD)
                local x = (keysPressed.D and 1 or 0) - (keysPressed.A and 1 or 0)
                local z = (keysPressed.S and 1 or 0) - (keysPressed.W and 1 or 0)
                finalMoveVector = Vector3.new(x, 0, z)
            end
            
            local isMoving = finalMoveVector.Magnitude > 0.1
            
            if isMoving and boostLevel == 3 then
                TweenService:Create(camera, TweenInfo.new(0.5), {FieldOfView = 100}):Play()
            else
                TweenService:Create(camera, TweenInfo.new(0.5), {FieldOfView = 70}):Play()
            end
            
            if isMoving then
                -- Normaliza o vetor para não ficar mais rápido na diagonal
                local dir = finalMoveVector.Unit 
                local finalDirection = (camCF.LookVector * -dir.Z + camCF.RightVector * dir.X).Unit
                bv.velocity = finalDirection * currentFlySpeed
                
                if boostLevel == 0 then PlayUniversalAnim(ANIMS.IDLE)
                elseif boostLevel == 1 then PlayUniversalAnim(ANIMS.WALK)
                else PlayUniversalAnim(ANIMS.RUN) end
            else
                bv.velocity = Vector3.new(0, 0.1, 0)
                PlayUniversalAnim(ANIMS.IDLE)
            end
            bg.CFrame = camCF
        end
        
        TweenService:Create(camera, TweenInfo.new(0.5), {FieldOfView = 70}):Play()
        if hum then hum.CameraOffset = Vector3.new(0, 0, 0) end
        bg:Destroy(); bv:Destroy()
        if char:FindFirstChild("Humanoid") then
            char.Humanoid.PlatformStand = false
            char.Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
        if currentTrack then currentTrack:Stop(0.5) end
        lastAnimId = nil
    end)
end

MainBtn.MouseButton1Click:Connect(function()
    flying = not flying
    if flying then
        MainBtn.Text = "UNFLY"; BoostBtn.Visible = true; 
        -- Só mostra o analógico se for mobile
        AnalogBase.Visible = UIS.TouchEnabled and not UIS.KeyboardEnabled
        StartFly()
    else
        MainBtn.Text = "FLY"; BoostBtn.Visible = false; AnalogBase.Visible = false
        boostLevel = 0; BoostBtn.Text = "BOOST"
    end
end)

BoostBtn.MouseButton1Click:Connect(function()
    boostLevel = (boostLevel + 1) % 4
    local texts = {"BOOST", "BOOST 2", "ULTRA", "MAX X"}
    BoostBtn.Text = texts[boostLevel + 1]
end)

plr.CharacterAdded:Connect(function()
    flying = false; MainBtn.Text = "FLY"; AnalogBase.Visible = false
    -- Reseta as teclas ao morrer
    keysPressed = {W = false, A = false, S = false, D = false}
end)

task.spawn(function()
    local scriptId = "FlySpwanScript"
    local scriptConfig = {
        Name = "FLY SPWAN",
        Category = "FLY SPWAN",
        GuiObject = Assets,
        OnDestroy = function()
            
            flying = false
            boostLevel = 0
            currentFlySpeed = 50
            moveVector = Vector3.new(0, 0, 0)
            activeTouch = nil
            keysPressed = {W = false, A = false, S = false, D = false}

            local char = plr.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    -- Remove BodyGyro e BodyVelocity órfãos
                    for _, obj in ipairs(hrp:GetChildren()) do
                        if obj:IsA("BodyGyro") or obj:IsA("BodyVelocity") then
                            pcall(function() obj:Destroy() end)
                        end
                    end
                end

                local hum = char:FindFirstChild("Humanoid")
                if hum then
                    pcall(function()
                        hum.CameraOffset = Vector3.new(0, 0, 0)
                        hum.PlatformStand = false
                        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                    end)
                end
            end

            -- Restaura FOV da câmera
            local camera = workspace.CurrentCamera
            if camera then
                pcall(function()
                    TweenService:Create(camera, TweenInfo.new(0.3), {FieldOfView = 70}):Play()
                end)
            end

            if currentTrack then
                pcall(function() currentTrack:Stop(0.5) end)
                currentTrack = nil
            end
            lastAnimId = nil

            pcall(function() Assets:Destroy() end)
        end
    }

    _G.ScriptManagerQueue = _G.ScriptManagerQueue or {}
    _G.RegisteredScriptDatabase = _G.RegisteredScriptDatabase or {}

    -- [SPWN] Lê visibilidade persistida em vez de hardcoded true
    local persistedVis = Assets:GetAttribute("SPWN_ManagedVisibility")

    _G.RegisteredScriptDatabase[scriptId] = {
        Name = scriptConfig.Name,
        Category = scriptConfig.Category,
        GuiObject = scriptConfig.GuiObject,
        IsVisible = (persistedVis == nil) and true or persistedVis,
        OnDestroy = scriptConfig.OnDestroy
    }

    local exists = false
    for _, item in ipairs(_G.ScriptManagerQueue) do
        if item.id == scriptId then
            exists = true
            item.config = scriptConfig
            break
        end
    end
    if not exists then
        table.insert(_G.ScriptManagerQueue, {id = scriptId, config = scriptConfig})
    end

    if _G.ScriptManager and type(_G.ScriptManager.RegisterScript) == "function" then
        _G.ScriptManager.RegisterScript(scriptId, scriptConfig)
    end
end)
